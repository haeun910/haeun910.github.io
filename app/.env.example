# 빌드 설정. 이 파일을 .env 로 복사해서 채우세요. 비밀키(서비스 롤, 토스 시크릿)는 절대 여기 넣지 마세요.
VITE_BASE=/toeic/
# 데모 모드(서버 없이 브라우저에서만 동작). 실서비스 빌드에서는 0 또는 삭제.
VITE_DEMO=0
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_TOSS_CLIENT_KEY=test_ck_...
# 소셜 로그인을 쓸 때만 (Supabase에서 provider를 켠 뒤): kakao,google
VITE_AUTH_PROVIDERS=
VITE_APP_NAME=토익 문장 단어장
VITE_SUPPORT_EMAIL=
# 전자상거래법 표시 사항 (화면 하단과 약관에 표시)
VITE_BIZ_NAME=
VITE_BIZ_OWNER=
VITE_BIZ_REG_NO=
VITE_BIZ_MAIL_ORDER_NO=
VITE_BIZ_ADDRESS=
VITE_BIZ_PHONE=
# 단어 데이터가 바뀌면 숫자를 올려서 브라우저 캐시를 갱신
VITE_CONTENT_VERSION=1
# 무료 베타 빌드(npm run build:free)의 "의견 보내기" 링크 (예: 구글폼 주소)
VITE_FEEDBACK_URL=
